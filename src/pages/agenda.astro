---
import Base from '../layouts/Base.astro';
import FormEmbed from '../components/FormEmbed.astro';
import { forms, site } from '../config/site';
---
<Base title="Agenda una conversación" description="Cuéntanos qué necesitas resolver y agenda una conversación con el equipo de Softmetrics.">
  <section style="background: var(--accent-tint); padding: 56px 0 88px">
    <div class="wrap" style="display: flex; gap: 40px; align-items: flex-start; flex-wrap: wrap">
      <div style="flex: 1 1 340px; display: flex; flex-direction: column; gap: 20px; max-width: 420px">
        <span style="font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent)" data-contexto>Conversemos</span>
        <h1 class="big" style="font-size: 40px; line-height: 1.1; font-weight: 800; margin: 0; letter-spacing: -0.02em">Agenda una conversación</h1>
        <p style="margin: 0; font-size: 17px; line-height: 1.6; color: var(--ink-2)">Cuéntanos en 2 minutos qué necesitas resolver. Te proponemos la solución adecuada y, si aplica, una propuesta a la medida.</p>
        <ol style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px">
          <li style="display: grid; grid-template-columns: 36px 1fr; gap: 10px"><span style="font-family: 'JetBrains Mono', monospace; color: var(--accent)">01</span><span style="color: var(--ink-2); line-height: 1.5">Completas el formulario.</span></li>
          <li style="display: grid; grid-template-columns: 36px 1fr; gap: 10px"><span style="font-family: 'JetBrains Mono', monospace; color: var(--accent)">02</span><span style="color: var(--ink-2); line-height: 1.5">Eliges el día y la hora de la llamada.</span></li>
          <li style="display: grid; grid-template-columns: 36px 1fr; gap: 10px"><span style="font-family: 'JetBrains Mono', monospace; color: var(--accent)">03</span><span style="color: var(--ink-2); line-height: 1.5">Conversamos y te enviamos los próximos pasos.</span></li>
        </ol>
        <p style="margin: 0; font-size: 15px; line-height: 1.6">¿Prefieres escribirnos? <a href={site.whatsapp} style="font-weight: 600">WhatsApp corporativo</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div style="flex: 2 1 480px">
        <FormEmbed src={forms.agenda} title="Agenda una conversación" height={640} />
      </div>
    </div>
  </section>
  <script is:inline>
    (function () {
      var map = { selecciona: 'Selecciona', 'insight-360': 'Insight 360', orientacion: 'Orientación profesional', consultores: 'Selecciona para consultores', radar: 'RADAR 2027' };
      var s = new URLSearchParams(location.search).get('solucion');
      var el = document.querySelector('[data-contexto]');
      if (s && map[s] && el) el.textContent = 'Conversemos sobre ' + map[s];
    })();
  </script>
</Base>
