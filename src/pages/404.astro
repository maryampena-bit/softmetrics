---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada">
  <section style="padding: 96px 0">
    <div class="wrap" style="display: flex; flex-direction: column; gap: 18px; max-width: 640px">
      <h1 style="font-size: 40px; font-weight: 800; margin: 0">Esta página no existe</h1>
      <p style="margin: 0; font-size: 17px; color: var(--ink-2)">Puede que el enlace haya cambiado. Vuelve al inicio o cuéntanos qué buscas.</p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap"><a class="btn btn-primary" href="/">Ir al inicio</a><a class="btn btn-outline" href="/agenda">Agenda una conversación</a></div>
    </div>
  </section>
</Base>
